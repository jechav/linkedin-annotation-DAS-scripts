# Copy to .env (gitignored), fill in, then load with:  set -a; source .env; set +a

# Both scripts. Value: the full cookie string from the `-b '...'` part of a "Copy as cURL"
# request on https://www.linkedin.com/ai-trainer/tasks. It must contain JSESSIONID.
LI_COOKIE=''

# check_batches.py only, optional. When both are set, notifications are also sent to this
# Telegram chat (see "Run on a server" in the README). Never commit real values.
TELEGRAM_BOT_TOKEN=''  # from @BotFather
TELEGRAM_CHAT_ID=''    # your chat id, from https://api.telegram.org/bot<token>/getUpdates
STATE_FILE=''          # optional: where --loop remembers seen batches (default .batches_state.json)

# tasks_weeks.py only. Command-line flags (--project, --tz, --week0) override these.
LI_PROJECT_ID=''       # required: projectId from the frontendAnnotationTaskResults request
LI_TZ=''               # optional IANA time zone, e.g. America/New_York (default UTC)
LI_WEEK0=''            # optional YYYY-MM-DD first day of week 0 (default: Monday-Sunday weeks)
